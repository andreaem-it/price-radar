# Runtime
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3000
MCP_PORT=3100

# Storage
DATA_DIR=./data
DATABASE_PATH=./data/price-radar.db

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Ollama (local AI fallback only)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Workers
SCRAPE_CONCURRENCY=1
AI_CONCURRENCY=2
SCRAPE_MAX_ATTEMPTS=3
SCRAPE_DELAY_MS=2000
SCRAPE_JITTER_MS=3000
SCHEDULER_INTERVAL_MS=60000

# tj-api backend (TechJournal)
TJ_API_BASE_URL=https://backend.techjournal.it
PRICE_RADAR_FEED_WRITE_KEY=your-secret-write-key
TJ_API_PER_PAGE=50
TJ_API_SOURCE=amazon_it

# Playwright
PLAYWRIGHT_HEADLESS=true
