# VM1 — Control plane (priceradar-control)
# Hostname suggerito: priceradar-control
# IP esempio: 192.168.1.10

NODE_ENV=production
LOG_LEVEL=info

API_PORT=3000
MCP_PORT=3100

DATA_DIR=/opt/price-radar/data
DATABASE_PATH=/opt/price-radar/data/price-radar.db

# Redis locale — deve essere raggiungibile anche da VM2
REDIS_URL=redis://127.0.0.1:6379

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

AI_CONCURRENCY=2
SCHEDULER_INTERVAL_MS=60000

# tj-api backend (TechJournal) — scheduler legge prodotti da monitorare
TJ_API_BASE_URL=https://backend.techjournal.it
# TJ_API_BASE_URL=http://localhost:3002
TJ_API_PER_PAGE=50
TJ_API_SOURCE=amazon_it

# Chiave condivisa con VM scraper (header X-Internal-Key)
INTERNAL_API_KEY=change-me-internal-key

# Su VM1 NON avviare scraper-worker
SCRAPE_CONCURRENCY=0

PLAYWRIGHT_HEADLESS=true
