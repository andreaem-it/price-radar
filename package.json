{
  "name": "price-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @price-radar/api-service dev",
    "dev:scheduler": "pnpm --filter @price-radar/scheduler-service dev",
    "dev:scraper": "pnpm --filter @price-radar/scraper-worker dev",
    "dev:mcp": "pnpm --filter @price-radar/mcp-service dev",
    "dev:ai": "pnpm --filter @price-radar/ai-worker dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @price-radar/db generate",
    "db:migrate": "pnpm --filter @price-radar/db migrate",
    "db:studio": "pnpm --filter @price-radar/db studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
