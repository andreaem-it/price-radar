[Unit]
Description=PriceRadar API Service
After=network-online.target redis-server.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__PRICE_RADAR_USER__
Group=__PRICE_RADAR_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=/usr/bin/node apps/api-service/dist/index.js
Restart=always
RestartSec=10
TimeoutStopSec=30

StandardOutput=append:__APP_DIR__/data/logs/api-service.log
StandardError=append:__APP_DIR__/data/logs/api-service.log

[Install]
WantedBy=multi-user.target
