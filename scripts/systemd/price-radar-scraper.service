[Unit]
Description=PriceRadar Scraper Worker
After=network-online.target remote-fs.target
Wants=network-online.target
Requires=remote-fs.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__PRICE_RADAR_USER__
Group=__PRICE_RADAR_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=/usr/bin/node apps/scraper-worker/dist/index.js
Restart=always
RestartSec=10
TimeoutStopSec=60

StandardOutput=append:__APP_DIR__/data/logs/scraper-worker.log
StandardError=append:__APP_DIR__/data/logs/scraper-worker.log

[Install]
WantedBy=multi-user.target
