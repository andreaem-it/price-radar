# VM2 — Scraper plane (priceradar-scraper)
# Hostname suggerito: priceradar-scraper
# IP esempio: 192.168.1.11
#
# Sostituisci 192.168.1.10 con l'IP reale di VM1 (control plane)

NODE_ENV=production
LOG_LEVEL=info

DATA_DIR=/opt/price-radar/data
# Stesso path di VM1 — directory montata via NFS da VM1
DATABASE_PATH=/opt/price-radar/data/price-radar.db

# Redis remoto su VM1
REDIS_URL=redis://192.168.1.10:6379

# Ollama non serve su VM2 (AI worker gira su VM1)
OLLAMA_URL=http://192.168.1.10:11434
OLLAMA_MODEL=llama3.2

# Solo scraping su questa VM
SCRAPE_CONCURRENCY=3
SCRAPE_MAX_ATTEMPTS=3

PLAYWRIGHT_HEADLESS=true
