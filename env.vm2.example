# VM2 — Scraper plane (priceradar-scraper)
# Hostname suggerito: priceradar-scraper
# IP esempio: 192.168.1.11
#
# Sostituisci 192.168.1.10 con l'IP reale di VM1 (control plane)

NODE_ENV=production
LOG_LEVEL=info

DATA_DIR=/opt/price-radar/data
# Stesso path di VM1 — directory montata via NFS da VM1
DATABASE_PATH=/opt/price-radar/data/price-radar.db

# Redis remoto su VM1 (control plane)
REDIS_URL=redis://192.168.0.189:6379

# Opzionale: Ollama su VM1 (AI worker gira lì, non su scraper)
OLLAMA_URL=http://192.168.0.189:11434
OLLAMA_MODEL=llama3.2

# Solo scraping su questa VM
SCRAPE_CONCURRENCY=3
SCRAPE_MAX_ATTEMPTS=3

# tj-api backend — scraper pusha prezzi dopo lo scrape
TJ_API_BASE_URL=https://backend.techjournal.it
# TJ_API_BASE_URL=http://localhost:3002
PRICE_RADAR_FEED_WRITE_KEY=your-secret-write-key
TJ_API_SOURCE=amazon_it

PLAYWRIGHT_HEADLESS=true
